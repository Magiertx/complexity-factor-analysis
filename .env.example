# Copy to `.env` and fill in the two generated values. `.env` is gitignored.
#
#   cp .env.example .env
#
# `docker compose up` refuses to start until both required values are set.

# --- Required ---

# Any strong random string. Left empty, compose stops until you fill it in.
POSTGRES_PASSWORD=

# Signs the session cookie that keeps users' jobs and uploads apart. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# --- Optional, sensible defaults in docker-compose.yml ---

# POSTGRES_DB=complexity
# POSTGRES_USER=postgres

# Set to 1 only when TLS terminates in front of the stack. Marks the session cookie Secure and
# enables HSTS. Leave unset for local http://localhost runs, where browsers would drop the cookie.
# SESSION_COOKIE_SECURE=1

# Public origin(s) of the frontend, comma separated.
# CORS_ORIGINS=http://localhost:3000

# Only if 172.28.0.0/16 collides with something on your machine. Used as the compose network
# subnet and as the range the API trusts for X-Forwarded-For.
# COMPOSE_SUBNET=172.28.0.0/16

# --- Limits ---

# Jobs one visitor may have queued or running at once (default 12). A dataset job for the
# factor analysis computes up to 50 logs or 200 nets. For a public demo, 2-3 is a reasonable value.
# MAX_ACTIVE_JOBS_PER_SESSION=3

# Event logs, and PNML nets, one factor analysis dataset may be built from (defaults 50 and
# 200). The data step shows the values in force. A dataset job mines every log
# with every chosen miner, so raising the first one raises the time and memory of a job.
# MAX_LOG_FILES=50
# MAX_PNML_FILES=200

# After the start the API computes the analyses of the bundled datasets in the background, with
# the standard settings and with the settings of their paper, so that opening one for the first
# time is instant (default 1 in docker-compose; 0 turns it off). It takes about 5 s of one CPU
# after each start and costs nothing afterwards; the cache is per API process and starts empty with each start.
# PRECOMPUTE_BUNDLED=1

# Factor analysis dataset jobs queued or running over all visitors (default 4). The miners
# share one ProM4Py container, so this is what keeps one visitor from blocking the others.
# MAX_ACTIVE_DATASET_JOBS=4

# Stability computations (bootstrap) queued or running over all visitors (default 2). A request
# over the limit is answered 429 "stability_jobs_busy".
# MAX_ACTIVE_STABILITY_JOBS=2

# Seconds ProM may take for one discovery, one miner on one log (default 300, at least 10).
# A discovery that takes longer fails for that input with "ProM took longer than 300 s for
# <miner> on <log>". ProM cannot cancel it, so the prom4py container restarts ProM 30 s later
# (a few seconds' outage). algoservice, celery_worker and prom4py all read this value.
# PROM4PY_CALL_TIMEOUT=300

# Seconds a discovery waits for ProM to answer when it refuses the connection, e.g. while the
# prom4py container starts (default 180). After that the input fails with "ProM4Py could not
# be reached"; later inputs then wait only 5 s until ProM answers again.
# PROM4PY_START_WAIT=180

# Per-visitor request limits. Format is "20/hour" or "5 per minute" (second|minute|hour|day).
# Defaults in brackets. A malformed value stops the service at startup.
# RATE_LIMIT_DEFAULT=120/minute     [any endpoint]
# RATE_LIMIT_LOG_STATS=300/hour     [log overview statistics, cheap]
# RATE_LIMIT_ANALYZE=60/hour        [single run]
# RATE_LIMIT_DATASETS=60/hour       [factor analysis datasets, uploads and jobs]
# RATE_LIMIT_FA_ANALYZE=120/minute  [factor analysis and loadings export]
# RATE_LIMIT_DATASET_STATUS=600/minute [dataset status, polled every 1.5 s per open tab]
# RATE_LIMIT_FEEDBACK=5/hour        [messages from the feedback form]

# Turns all request limits off. For local development only; the job quota still applies.
# For a local end-to-end run, docker-compose.e2e.yml sets it without touching this file.
# RATE_LIMIT_DISABLED=1

# --- Interpretation of the factors by Claude (optional) ---

# Anthropic API key from the Claude Console. Empty or unset turns live interpretation off; the
# precomputed interpretations of the bundled datasets are still shown. The key stays on the
# server: it is never logged and never sent to the browser. Set a spending limit for it in the
# Console (see docs/DEPLOYMENT.md).
# ANTHROPIC_API_KEY=

# Model and effort; Claude Opus 5.5 at medium effort by default.
# INTERPRETATION_MODEL=claude-opus-5-5
# INTERPRETATION_EFFORT=medium        [low, medium, high, xhigh, max]
# What the visitor may choose in the interpretation step (comma-separated; the default above
# is always offered). Higher efforts cost more and take longer.
# INTERPRETATION_MODELS=claude-opus-5-5,claude-sonnet-5-5
# INTERPRETATION_EFFORTS=low,medium,high,xhigh

# Live calls to Claude per visitor session, and per day over all visitors. Cached and
# precomputed interpretations do not count.
# INTERPRETATION_RATE_LIMIT=10/hour
# INTERPRETATION_DAILY_CAP=200

# --- Feedback form (optional) ---

# The form is anonymous: a message is kept in the database without the sender's address or
# session. If mail is set up, each message is also sent to FEEDBACK_TO; without a host and a
# recipient it is only kept. Read the kept messages with scripts/feedback.py (docs/DEPLOYMENT.md).
# FEEDBACK_SMTP_HOST=
# FEEDBACK_SMTP_PORT=587
# FEEDBACK_SMTP_USER=
# FEEDBACK_SMTP_PASSWORD=
# Sender address; defaults to the user, then to the recipient.
# FEEDBACK_SMTP_FROM=
# FEEDBACK_TO=
# starttls (default, usually port 587) or ssl (usually port 465).
# FEEDBACK_SMTP_TLS=starttls
