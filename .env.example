# Copy to `.env` and fill in the two generated values. `.env` is gitignored.
#
#   cp .env.example .env
#
# Without this file `docker compose up` refuses to start — deliberately. Both variables used
# to have working defaults, which meant a deployment following the guide ran on the database
# password `postgres` and a session signing key printed in this repository. Failing loudly is
# the fix; this template is so that failing loudly does not also mean failing obscurely.

# --- Required ---

# Any strong random string.
POSTGRES_PASSWORD=change_me

# Signs the session cookie, which is the only thing separating one user's jobs, uploads and
# results from another's. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=change_me

# --- Optional, sensible defaults in docker-compose.yml ---

# POSTGRES_DB=toolkit
# POSTGRES_USER=postgres

# Set to 1 only when TLS terminates in front of the stack. Marks the session cookie Secure and
# enables HSTS — leave unset for local http://localhost runs, or browsers will refuse the
# cookie and nothing will work.
# SESSION_COOKIE_SECURE=1

# Only if 172.28.0.0/16 collides with something on your machine. Used twice: as the compose
# network subnet and as the range the API trusts to have set X-Forwarded-For.
# COMPOSE_SUBNET=172.28.0.0/16

# --- Limits (for a public demo, this is the section you want) ---

# THE ONE THAT MATTERS. How many jobs one visitor may have queued or running at once.
# Request limits below cap how often someone *starts* work; this caps how much of the machine
# they hold — and a single batch request is up to 10 runs. For a demo deployment where many
# people click around at the same time, 2-3 is the sensible setting.
# MAX_ACTIVE_JOBS_PER_SESSION=3

# Per-visitor request limits. Format is "20/hour" or "5 per minute" (second|minute|hour|day).
# Defaults in brackets. A malformed value stops the service on purpose rather than silently
# leaving the default in force.
# RATE_LIMIT_DEFAULT=120/minute     [any endpoint]
# RATE_LIMIT_LOG_STATS=300/hour     [log overview statistics, cheap]
# RATE_LIMIT_ANALYZE=60/hour        [single run]
# RATE_LIMIT_BATCH=20/hour          [up to 10 logs per request]

# Turns all request limits off. Intended for local development — never set it in a
# deployment; the job quota above keeps working either way.
# RATE_LIMIT_DISABLED=1
